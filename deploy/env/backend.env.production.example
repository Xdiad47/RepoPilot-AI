# Production environment for the RepoPilot AI backend on the VPS.
# Install as /etc/repopilot/backend.env  (owner root, group repopilot, mode 640). NEVER commit the real file.

ENVIRONMENT=production
LLM_API_KEY=__PASTE_ON_THE_SERVER_ONLY__
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# Your Vercel production URL (comma-separate to also allow a custom domain).
FRONTEND_ORIGIN=https://__YOUR_PROJECT__.vercel.app
TRUST_PROXY_HEADERS=true

DATA_DIR=/var/lib/repopilot/data
WORKSPACE_ROOT=/var/lib/repopilot/workspaces

# The VPS is small (1 vCPU / 2 GB, shared with other sites): keep these conservative.
MAX_CONCURRENT_INVESTIGATIONS=1
RATE_LIMIT_PER_HOUR=5
DAILY_GLOBAL_LIMIT=60
MAX_REPOSITORY_SIZE_MB=30
MAX_REPAIR_ITERATIONS=3

# Test validation is OFF until the sandbox is hardened for the VPS (see docs/SECURITY.md).
SANDBOX_ENABLED=false
