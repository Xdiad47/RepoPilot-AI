# Public configuration only. Everything prefixed NEXT_PUBLIC_ is embedded in the browser bundle,
# so NEVER put API keys or other secrets here.

# URL of the RepoPilot backend (no trailing slash).
#   local development: http://localhost:8000
#   production:        https://<your-backend-subdomain>   (must be HTTPS; required, there is no fallback)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: public repository used by the one-click examples on the landing page.
# NEXT_PUBLIC_DEMO_REPO_URL=https://github.com/Xdiad47/repopilot-demo-bugs
