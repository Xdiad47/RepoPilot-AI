# RepoPilot AI backend configuration. Copy to backend/.env for local development.
# NEVER commit the real .env. In production use /etc/repopilot/backend.env (see deploy/env/).

# --- LLM provider: any OpenAI-compatible /chat/completions endpoint -------------------------------------------
# Groq (default):   https://api.groq.com/openai/v1   model e.g. openai/gpt-oss-120b
# OpenAI:           https://api.openai.com/v1
# Self-hosted vLLM: http://localhost:8000/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional, only for reasoning models ("low" | "medium" | "high"). Lower = faster and cheaper.
LLM_REASONING_EFFORT=low

# --- Web ----------------------------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API (your Vercel URL in production).
FRONTEND_ORIGIN=http://localhost:3000
# Set true ONLY behind nginx (it sets X-Real-IP) so rate limiting sees real client IPs.
TRUST_PROXY_HEADERS=false
ENVIRONMENT=development

# --- Repository limits --------------------------------------------------------------------------------------
MAX_REPOSITORY_SIZE_MB=50
MAX_SOURCE_FILES=5000
MAX_FILE_SIZE_KB=256
CLONE_TIMEOUT_SECONDS=60
# Optional GitHub token (no scopes needed) to raise the public-API rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# --- Agent --------------------------------------------------------------------------------------------------
MAX_REPAIR_ITERATIONS=3
MAX_CONTEXT_CHARS=12000
INVESTIGATION_TIMEOUT_SECONDS=600

# --- Sandboxed test validation -----------------------------------------------------------------------------
# Requires Docker and the image built from deploy/sandbox/Dockerfile. When false, patches are still generated
# but the UI reports "Validation unavailable".
SANDBOX_ENABLED=false
SANDBOX_IMAGE=repopilot-sandbox:latest
TEST_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0

# --- Abuse controls -----------------------------------------------------------------------------------------
MAX_CONCURRENT_INVESTIGATIONS=1
RATE_LIMIT_PER_HOUR=5
DAILY_GLOBAL_LIMIT=100
